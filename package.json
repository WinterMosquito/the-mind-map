{
	"name": "mindmap",
	"version": "0.0.1",
	"description": "Mind map rendering for Markdown in Obsidian: edit .mindmap.md as a mind map with Markdown outline round-trip and Obsidian-native links/images.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"mind-map",
		"simple-mind-map"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WinterMosquito/The-Mind-Map.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
